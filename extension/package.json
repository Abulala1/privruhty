{
  "name": "privruhty-extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && esbuild src/content.ts --bundle --minify --format=iife --outfile=dist/content.js && esbuild src/attachmentEntry.ts --bundle --minify --format=iife --outfile=dist/attachments.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write --ignore-path ../.prettierignore . ../*.md ../docs ../test-data/README.md ../.github ../.prettierrc.json",
    "format:check": "prettier --check --ignore-path ../.prettierignore . ../*.md ../docs ../test-data/README.md ../.github ../.prettierrc.json"
  },
  "dependencies": {
    "papaparse": "^5.7.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.10.1",
    "typescript": "^5.6.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.20.0 || >=24.0.0"
  }
}
